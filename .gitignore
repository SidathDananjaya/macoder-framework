# ── Python virtual environments (never submit) ──────────────────────────────
vision_env/
backend/venv/
venv/
.venv/
env/
.env

# ── Node (frontend) ─────────────────────────────────────────────────────────
frontend/node_modules/
node_modules/
frontend/dist/
frontend/.vite/

# ── Raw dataset (13 GB RAVDESS — obtain separately, see README) ──────────────
datasets/raw/

# ── Runtime scratch / temp ──────────────────────────────────────────────────
temp_uploads/
outputs/                       # generated session logs & reports (regenerated at run time)

# ── Byte-compiled / logs / local secrets ────────────────────────────────────
__pycache__/
*.pyc
*.log
*.db
backend/app/core/config_local.py

# ── IDE / OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Testing & coverage caches ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────────────────────
# INTENTIONALLY TRACKED for submission (do NOT re-ignore):
#   experiments/**   → trained models (.pkl/.h5), metrics, confusion matrices, SHAP plots
#   datasets/processed/**  → engineered feature CSVs (~17 MB)
#   test-results/**  → system-testing screenshots (test evidence)
# The examiner needs these to run and verify the system, so the blanket
# *.pkl / *.h5 / *.npy and experiments/*/ ignores were removed on purpose.
# ─────────────────────────────────────────────────────────────────────────────
